# ── Meta Graph API ──
META_ACCESS_TOKEN=
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v20.0
META_GRAPH_TIMEOUT=30000
META_DRY_RUN=true

# ── Worker ──
WORKER_POLL_INTERVAL=3000
WORKER_MAX_CONCURRENT=3

# ── zrok ──
ZROK2_ENABLE_TOKEN=
ZROK2_API_ENDPOINT=
ZROK2_AGENT_CONSOLE_PORT=8888

# ── Storage ──
# local: files stored on disk, served through Next.js (works behind ngrok)
# minio: files stored in S3/MinIO (requires public MinIO URL)
MINIO_STORAGE_MODE=local

# Only needed if MINIO_STORAGE_MODE=minio
MINIO_ENDPOINT=
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_BUCKET=media

# ── URLs ──
# APP_URL MUST be the public URL Meta's servers can reach.
# With ngrok: https://your-ngrok-id.ngrok.io
# With a real domain: https://poster.yourdomain.com
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Authentication ──
# Only required if you set up the auth middleware
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=
