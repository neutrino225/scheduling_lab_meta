# Meta Lab — Environment Configuration
# Copy this file to .env.local and adjust values

# --- Core ---
NODE_ENV=development

# --- Meta Graph API ---
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v20.0
META_GRAPH_TIMEOUT=30000
META_DRY_RUN=true
# META_ACCESS_TOKEN=your-facebook-user-access-token

# --- Worker ---
WORKER_POLL_INTERVAL=3000
WORKER_MAX_CONCURRENT=3

# --- MinIO / Storage ---
MINIO_STORAGE_MODE=local
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=media

# --- Auth ---
AUTH_USERNAME=test
AUTH_PASSWORD=test123
AUTH_SECRET=meta-lab-dev-secret-change-me

# --- Facebook Login (OAuth) ---
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
NEXT_PUBLIC_FACEBOOK_API_VERSION=v20.0
FACEBOOK_APP_SECRET=your-facebook-app-secret
NEXT_PUBLIC_API_URL=http://localhost:3000
